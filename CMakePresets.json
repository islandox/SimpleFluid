{
    "version": 3,
    "configurePresets": [
        {
            "name": "LLVM-ninja-multi",
            "displayName": "LLVM with pre-built Trilinos and OpenMPI",
            "description": "Multi config build with Trilinos (Tpetra, STK, Kokkos, Teuchos) and OpenMPI",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build-llvm",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "Trilinos_DIR": "$env{HOME}/local/mathlibs/trilinos17.2-openmpi5-pic/lib/cmake/Trilinos",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "GCC-ninja-multi",
            "displayName": "GCC with pre-built Trilinos and OpenMPI",
            "description": "Local multi-config build using the shared Trilinos and OpenMPI settings",
            "inherits": "LLVM-ninja-multi",
            "binaryDir": "${sourceDir}/build-gcc",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "GCC-Debug",
            "configurePreset": "GCC-ninja-multi",
            "configuration": "Debug",
            "jobs": 8
        },
        {
            "name": "GCC-Release",
            "configurePreset": "GCC-ninja-multi",
            "configuration": "Release",
            "jobs": 8
        },
        {
            "name": "GCC-RelWithDebInfo",
            "configurePreset": "GCC-ninja-multi",
            "configuration": "RelWithDebInfo",
            "jobs": 8
        },
        {
            "name": "LLVM-Debug",
            "configurePreset": "LLVM-ninja-multi",
            "configuration": "Debug",
            "jobs": 8
        },
        {
            "name": "LLVM-Release",
            "configurePreset": "LLVM-ninja-multi",
            "configuration": "Release",
            "jobs": 8
        },
        {
            "name": "LLVM-RelWithDebInfo",
            "configurePreset": "LLVM-ninja-multi",
            "configuration": "RelWithDebInfo",
            "jobs": 8
        },
        {
            "name": "LLVM-RelWithDebInfo-Static",
            "configurePreset": "LLVM-ninja-multi",
            "configuration": "RelWithDebInfo",
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "GCC-Debug",
            "configurePreset": "GCC-ninja-multi",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "GCC-RelWithDebInfo",
            "configurePreset": "GCC-ninja-multi",
            "configuration": "RelWithDebInfo",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
