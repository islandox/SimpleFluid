{
    "version": 3,
    "configurePresets": [
        {
            "name": "Ninja-MultiConfig",
            "displayName": "Multi-Config (Trilinos + OpenMPI)",
            "description": "Multi config build with Trilinos (Tpetra, STK, Kokkos, Teuchos) and OpenMPI",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_PREFIX_PATH": "$env{HOME}/Library/compiled/trilinos17-openmpi5",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "Local",
            "displayName": "Local Multi-Config",
            "description": "Local multi-config build using the shared Trilinos and OpenMPI settings",
            "inherits": "Ninja-MultiConfig"
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Ninja-MultiConfig",
            "configuration": "Debug",
            "jobs": 8
        },
        {
            "name": "Release",
            "configurePreset": "Ninja-MultiConfig",
            "configuration": "Release",
            "jobs": 8
        },
        {
            "name": "RelWithDebInfo",
            "configurePreset": "Ninja-MultiConfig",
            "configuration": "RelWithDebInfo",
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "Debug",
            "configurePreset": "Ninja-MultiConfig",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "RelWithDebInfo",
            "configurePreset": "Ninja-MultiConfig",
            "configuration": "RelWithDebInfo",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
