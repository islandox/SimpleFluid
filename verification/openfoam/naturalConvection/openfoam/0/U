    pipeWall    { type fixedValue; value uniform (0 0 0); }
    tunnelWall  { type fixedValue; value uniform (0 0 0); }
    downWall    { type fixedValue; value uniform (0 0 0); }
    inlet       { type fixedValue; value uniform (0 0 0); }
    outlet      { type fixedValue; value uniform (0 0 0); }
    cyclicLeft  { type cyclic; }
    cyclicRight { type cyclic; }
}
