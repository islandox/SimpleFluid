        type    kqRWallFunction;
        value   uniform 0.00375;
    }
    tunnelWall
    {
        type    kqRWallFunction;
        value   uniform 0.00375;
    }
    downWall
    {
        type    kqRWallFunction;
        value   uniform 0.00375;
    }
    inlet
    {
        type    kqRWallFunction;
        value   uniform 0.00375;
    }
    outlet
    {
        type    kqRWallFunction;
        value   uniform 0.00375;
    }
    cyclicLeft  { type cyclic; }
    cyclicRight { type cyclic; }
}
