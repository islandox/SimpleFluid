FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    p_rgh
    {
        solver          GAMG;
        tolerance       1e-8;
        relTol          0.05;
        smoother        GaussSeidel;
    }
    "(U|T)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.05;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    pRefCell       0;
    pRefValue      0;
    residualControl
    {
        p_rgh       1e-6;
        U           1e-6;
        T           1e-6;
    }
}
relaxationFactors
{
    fields { p_rgh 0.3; }
    equations { U 0.7; T 0.7; }
}
